from typing import Annotated

from fastapi import Depends, FastAPI
from sqlalchemy.orm import Session

from . import models, schemas
from .db import Base, engine, get_db

app = FastAPI(title="$name")
Base.metadata.create_all(bind=engine)


@app.get("/")
def root():
    return {"message": "$name", "status": "ok"}


@app.get("/health")
def health():
    return {"status": "ok"}


@app.get("/items", response_model=list[schemas.ItemRead])
def list_items(db: Annotated[Session, Depends(get_db)]):
    return db.query(models.Item).all()


@app.post("/items", response_model=schemas.ItemRead, status_code=201)
def create_item(payload: schemas.ItemCreate, db: Annotated[Session, Depends(get_db)]):
    item = models.Item(name=payload.name)
    db.add(item)
    db.commit()
    db.refresh(item)
    return item

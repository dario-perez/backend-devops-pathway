#!/usr/bin/env bash

BASE="${DEV_REPO:-$HOME/Documents/study/backend-devops-pathway}"
PROJECTS_DIR="${PROJECTS_DIR:-$HOME/Documents/study/projects}"
LOG_FILE="${DEV_LOG:-$BASE/docs/worklog.md}"
BACKUP_DIR="${BACKUP_DIR:-$HOME/Backups}"
PYTHON_VERSION="${PYTHON_VERSION:-3.13}"

has() {
    command -v "$1" >/dev/null 2>&1
}

info() {
    printf '%s\n' "$*"
}

warn() {
    printf '[WARN] %s\n' "$*" >&2
}

die() {
    printf '[ERROR] %s\n' "$*" >&2
    exit 1
}

confirm() {
    local reply
    read -r -p "$1 [y/N] " reply
    [[ "$reply" =~ ^[yY]$ ]]
}

usage() {
    cat <<'EOF'
DEV TOOLKIT

Usage:
  dev new python <name>     Create a Python project in PROJECTS_DIR
  dev new api <name>        Create a FastAPI + Docker project
  dev init [dir]            Add git, README, env example, pre-commit
  dev run [dir]             Activate the venv and run the app
  dev test [dir]            Run pytest
  dev lint [dir]            Run ruff check
  dev fmt [dir]             Run ruff format
  dev up [dir]              docker compose up -d --build
  dev down [dir]            docker compose down
  dev db [dir]              Start the compose db and wait for readiness
  dev ship [message]        Lint, test, commit, push, and open a PR
  dev status [dir]          Git branch, sync state, last commit, PR
  dev clean [dir]           Remove caches (--venv, --docker, -y)
  dev doctor                Check tools, Docker, GitHub auth, disk
  dev secrets [dir]         Scan for secrets (gitleaks/trufflehog/rg)
  dev backup [dir]          Dump the compose DB or archive the project
  dev log <message>         Append a timestamped work log entry
  dev roadmap               Show milestones and unchecked items
  dev save <message>        Add, commit, and push all changes
  dev health                Show RAM, CPU, and disk usage
  dev help                  Show this help

Environment:
  DEV_REPO                  Curriculum repo root
  PROJECTS_DIR              Where new projects are created
  DEV_LOG                   Work log path
  BACKUP_DIR                Backup destination
  PYTHON_VERSION            Preferred Python version (default: 3.13)
  DEV_SKIP_INSTALL=1        Skip dependency installation in generators
  SKIP_CHECKS=1             Skip lint/test in dev ship
EOF
}

validate_name() {
    [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "Invalid project name: $1"
}

pick_python() {
    if has "python${PYTHON_VERSION}"; then
        printf 'python%s' "$PYTHON_VERSION"
    elif has python3; then
        printf 'python3'
    else
        printf ''
    fi
}

create_venv() {
    local folder=$1
    local old=$PWD
    cd "$folder" || return 1

    if has uv; then
        if uv venv --python "$PYTHON_VERSION" .venv >/dev/null 2>&1; then
            info "[OK] .venv created with uv (Python $PYTHON_VERSION)"
        elif uv venv .venv >/dev/null 2>&1; then
            warn "Python $PYTHON_VERSION unavailable to uv; created .venv with default"
        else
            cd "$old" || return 1
            die "uv could not create .venv"
        fi
    else
        local py
        py=$(pick_python)
        [[ -n "$py" ]] || {
            cd "$old" || return 1
            die "python3 is required"
        }
        if [[ "$py" != "python${PYTHON_VERSION}" ]]; then
            warn "python${PYTHON_VERSION} not found; using $py"
        fi
        "$py" -m venv .venv || {
            cd "$old" || return 1
            die "Failed to create .venv"
        }
        info "[OK] .venv created with $py"
    fi

    cd "$old" || return 1
}

activate_venv() {
    local folder=$1

    if [[ -f "$folder/.venv/bin/activate" ]]; then
        source "$folder/.venv/bin/activate"
    elif [[ -f "$folder/venv/bin/activate" ]]; then
        source "$folder/venv/bin/activate"
    else
        return 1
    fi
}

ensure_venv() {
    local folder=$1

    if ! activate_venv "$folder"; then
        warn "No virtual environment found; creating one"
        create_venv "$folder"
        activate_venv "$folder" || die "Could not activate .venv"
    fi
}

install_deps() {
    local folder=$1
    shift
    local old=$PWD
    cd "$folder" || return 1

    if has uv; then
        uv pip install --python .venv/bin/python "$@" || warn "Dependency install failed"
    else
        source .venv/bin/activate
        python -m pip install --upgrade pip >/dev/null 2>&1 || true
        pip install "$@" || warn "Dependency install failed"
        deactivate 2>/dev/null || true
    fi

    cd "$old" || return 1
}

git_init_commit() {
    local folder=$1
    local message=$2
    local old=$PWD
    cd "$folder" || return 1

    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        git init -q
    fi

    git add .

    if git diff --cached --quiet; then
        info "No changes to commit"
    else
        git commit -q -m "$message" || warn "git commit failed; configure user.name and user.email"
    fi

    cd "$old" || return 1
}

create_python_project() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "Usage: dev new python <project-name>"
    validate_name "$name"

    local folder="$PROJECTS_DIR/$name"
    [[ -e "$folder" ]] && die "Project already exists: $folder"

    mkdir -p "$folder/app" "$folder/tests"
    create_venv "$folder"

    : > "$folder/app/__init__.py"

    cat > "$folder/app/main.py" <<'EOF'
def main():
    print("Hello from the project")


if __name__ == "__main__":
    main()
EOF

    cat > "$folder/tests/test_main.py" <<'EOF'
from app.main import main


def test_main(capsys):
    main()
    assert "Hello" in capsys.readouterr().out
EOF

    cat > "$folder/README.md" <<EOF
# $name

Python project generated by \`dev new python\`.

## Setup

\`\`\`bash
source .venv/bin/activate
pip install -r requirements-dev.txt
\`\`\`

## Run

\`\`\`bash
python -m app.main
\`\`\`

## Test

\`\`\`bash
pytest -q
\`\`\`
EOF

    cat > "$folder/.gitignore" <<'EOF'
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.env
.vscode/
.idea/
.DS_Store
EOF

    cat > "$folder/pyproject.toml" <<EOF
[project]
name = "$name"
version = "0.1.0"
requires-python = ">=3.13"

[tool.pytest.ini_options]
pythonpath = ["."]
testpaths = ["tests"]

[tool.ruff]
line-length = 100
target-version = "py313"

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP"]
EOF

    cat > "$folder/requirements-dev.txt" <<'EOF'
pytest>=8
ruff>=0.8
pre-commit>=4
EOF

    if [[ "${DEV_SKIP_INSTALL:-0}" != "1" ]]; then
        install_deps "$folder" -r requirements-dev.txt
    else
        warn "Skipping dependency install (DEV_SKIP_INSTALL=1)"
    fi

    git_init_commit "$folder" "Initial Python project"

    info "[OK] Python project ready: $folder"
}


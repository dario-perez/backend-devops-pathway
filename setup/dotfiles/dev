init_project() {
    local folder="${1:-$PWD}"
    cd "$folder" || die "Cannot enter $folder"

    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        git init -q
        info "[OK] git initialized"
    fi

    if [[ ! -f .gitignore ]]; then
        cat > .gitignore <<'EOF'
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.env
*.db
.vscode/
.idea/
.DS_Store
EOF
        info "[OK] .gitignore created"
    fi

    if [[ ! -f README.md ]]; then
        printf '# %s\n\nProject notes.\n' "$(basename "$PWD")" > README.md
        info "[OK] README.md created"
    fi

    if [[ ! -f .env.example ]]; then
        printf '# Copy to .env and fill in values\n' > .env.example
        info "[OK] .env.example created"
    fi

    if [[ ! -f .pre-commit-config.yaml ]]; then
        cat > .pre-commit-config.yaml <<'EOF'
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v5.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-added-large-files
EOF
        info "[OK] .pre-commit-config.yaml created"
    fi

    if has pre-commit; then
        pre-commit install >/dev/null 2>&1 &&
            info "[OK] pre-commit hook installed" ||
            warn "pre-commit hook could not be installed"
    fi

    if ! git rev-parse HEAD >/dev/null 2>&1; then
        git add .
        git commit -q -m "Initial commit" ||
            warn "Initial commit failed; configure user.name and user.email"
    fi

    info "[OK] project initialized: $PWD"
}

run_project() {
    local folder="${1:-$PWD}"
    cd "$folder" || die "Cannot enter $folder"
    ensure_venv "$folder"

    if [[ -f app/main.py ]] && grep -q 'FastAPI' app/main.py; then
        has uvicorn || die "uvicorn is not installed; run pip install -r requirements-dev.txt"
        local port="${PORT:-8000}"
        info "Starting FastAPI on http://127.0.0.1:$port"
        exec uvicorn app.main:app --reload --host 127.0.0.1 --port "$port"
    elif [[ -f app/main.py ]]; then
        info "Starting app.main"
        exec python -m app.main
    elif [[ -f main.py ]]; then
        info "Starting main.py"
        exec python main.py
    else
        die "No app/main.py or main.py found in $folder"
    fi
}

test_project() {
    local folder="${1:-$PWD}"
    cd "$folder" || die "Cannot enter $folder"
    ensure_venv "$folder"

    if has pytest; then
        pytest -q
    elif has uv; then
        uv run pytest -q
    else
        die "pytest is not installed; run pip install -r requirements-dev.txt"
    fi
}

lint_project() {
    local folder="${1:-$PWD}"
    cd "$folder" || die "Cannot enter $folder"
    ensure_venv "$folder"

    if has ruff; then
        ruff check .
    elif has uv; then
        uv run ruff check .
    else
        die "ruff is not installed; run pip install -r requirements-dev.txt"
    fi
}

fmt_project() {
    local folder="${1:-$PWD}"
    cd "$folder" || die "Cannot enter $folder"
    ensure_venv "$folder"

    if has ruff; then
        ruff format .
    elif has black; then
        black .
    elif has uv; then
        uv run ruff format .
    else
        die "ruff is not installed; run pip install -r requirements-dev.txt"
    fi
}

up_project() {
    local folder="${1:-$PWD}"
    cd "$folder" || die "Cannot enter $folder"

    if docker compose version >/dev/null 2>&1; then
        docker compose up -d --build
        docker compose ps
    elif has docker-compose; then
        docker-compose up -d --build
        docker-compose ps
    else
        die "Docker Compose is not available"
    fi
}

down_project() {
    local folder="${1:-$PWD}"
    cd "$folder" || die "Cannot enter $folder"

    if docker compose version >/dev/null 2>&1; then
        docker compose down
    elif has docker-compose; then
        docker-compose down
    else
        die "Docker Compose is not available"
    fi
}

db_project() {
    local folder="${1:-$PWD}"
    cd "$folder" || die "Cannot enter $folder"

    if [[ ! -f compose.yaml && ! -f docker-compose.yml ]]; then
        die "No compose.yaml or docker-compose.yml in $folder"
    fi

    if docker compose version >/dev/null 2>&1; then
        docker compose up -d db
        local i
        for i in $(seq 1 30); do
            if docker compose exec -T db pg_isready -U "${POSTGRES_USER:-app}" >/dev/null 2>&1; then
                info "[OK] database ready"
                return 0
            fi
            sleep 2
        done
    else
        die "Docker Compose is not available"
    fi

    warn "Database did not become ready within 60 seconds"
    return 1
}

ship() {
    local message="${1:-}"
    git rev-parse --git-dir >/dev/null 2>&1 || die "Not a git repository"

    if [[ -z "$message" ]]; then
        message="chore: update $(date +%F)"
    fi

    if [[ "${SKIP_CHECKS:-0}" != "1" ]]; then
        lint_project "$PWD" || die "Lint failed"
        test_project "$PWD" || die "Tests failed"
    fi

    if git diff --quiet && git diff --cached --quiet; then
        info "No changes to commit"
    else
        git add -A
        git commit -m "$message" || die "Commit failed"
    fi

    local branch
    branch=$(git branch --show-current)

    if ! git push 2>/dev/null; then
        git push -u origin "$branch" || die "Push failed"
    fi

    if has gh; then
        if [[ "$branch" != "main" && "$branch" != "master" ]]; then
            gh pr create --fill || warn "PR creation failed (maybe a PR already exists)"
        else
            warn "On $branch; skipped PR creation"
        fi
    fi

    info "[OK] shipped branch $branch"
}

status_project() {
    local folder="${1:-$PWD}"
    cd "$folder" || die "Cannot enter $folder"
    git rev-parse --git-dir >/dev/null 2>&1 || die "Not a git repository"

    git status -sb

    local branch upstream
    branch=$(git branch --show-current)
    info "Branch: $branch"

    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
    if [[ -n "$upstream" ]]; then
        local behind ahead
        read -r behind ahead < <(git rev-list --left-right --count '@{u}...HEAD')
        info "Upstream: $upstream (behind $behind, ahead $ahead)"
    else
        warn "No upstream branch configured"
    fi

    git log -1 --oneline

    if has gh; then
        gh pr status 2>/dev/null | sed -n '1,20p' || true
    fi
}

clean_project() {
    local assume_yes=0
    local remove_venv=0
    local remove_docker=0
    local folder="$PWD"
    local arg

    for arg in "$@"; do
        case "$arg" in
            -y|--yes) assume_yes=1 ;;
            --venv) remove_venv=1 ;;
            --docker) remove_docker=1 ;;
            -*) die "Unknown option: $arg" ;;
            *) folder="$arg" ;;
        esac
    done

    cd "$folder" || die "Cannot enter $folder"

    if (( ! assume_yes )); then
        confirm "Remove Python caches and build artifacts in $folder?" || {
            info "Cancelled"
            return 0
        }
    fi

    find . -type d \( -name __pycache__ -o -name .pytest_cache -o -name .ruff_cache -o -name .mypy_cache \) -prune -exec rm -rf {} +
    find . -type f -name '*.pyc' -delete
    rm -rf build dist .coverage htmlcov
    info "[OK] caches removed"

    if (( remove_venv )); then
        rm -rf .venv venv
        info "[OK] virtual environments removed"
    fi

    if (( remove_docker )); then
        if has docker; then
            docker image prune -f
        else
            warn "docker is not installed"
        fi
    fi
}

check_cmd() {
    local label=$1
    shift

    if "$@" >/dev/null 2>&1; then
        local version
        version=$("$@" 2>&1 | head -n 1)
        printf '  [OK]   %-16s %s\n' "$label" "$version"
    else
        printf '  [MISS] %-16s\n' "$label"
    fi
}

doctor() {
    info "DEV DOCTOR"
    info "----------"

    check_cmd git git --version
    check_cmd python3 python3 --version
    check_cmd "python$PYTHON_VERSION" "python$PYTHON_VERSION" --version
    check_cmd uv uv --version
    check_cmd docker docker --version
    check_cmd "docker compose" docker compose version
    check_cmd gh gh --version
    check_cmd ruff ruff --version
    check_cmd pytest pytest --version
    check_cmd pre-commit pre-commit --version
    check_cmd gitleaks gitleaks version
    check_cmd jq jq --version
    check_cmd kubectl kubectl version --client
    check_cmd terraform terraform version
    check_cmd ansible ansible --version

    info ""
    info "RUNTIME"
    info "-------"

    if has docker && docker info >/dev/null 2>&1; then
        info "  [OK]   Docker daemon reachable"
    else
        info "  [WARN] Docker daemon not reachable"
    fi

    if has gh && gh auth status >/dev/null 2>&1; then
        info "  [OK]   GitHub CLI authenticated"
    else
        info "  [WARN] GitHub CLI not authenticated"
    fi

    if has systemctl; then
        local failed
        failed=$(systemctl --failed --no-legend 2>/dev/null | wc -l)
        if [[ "$failed" -eq 0 ]]; then
            info "  [OK]   No failed systemd units"
        else
            info "  [WARN] $failed failed systemd units"
        fi
    fi

    info ""
    info "DISK"
    info "----"
    df -h / | sed -n '1,2p'

    info ""
    info "PROJECTS"
    info "--------"
    info "  DEV_REPO:     $BASE"
    info "  PROJECTS_DIR: $PROJECTS_DIR"
    info "  DEV_LOG:      $LOG_FILE"
    info "  BACKUP_DIR:   $BACKUP_DIR"
}

secrets_scan() {
    local folder="${1:-$PWD}"
    cd "$folder" || die "Cannot enter $folder"

    if has gitleaks; then
        gitleaks detect --source . --no-git --redact -v
    elif has trufflehog; then
        trufflehog filesystem . --no-update
    elif has rg; then
        if rg -n --hidden \
            -g '!.git/**' -g '!node_modules/**' -g '!.venv/**' -g '!venv/**' \
            -e 'AKIA[0-9A-Z]{16}' \
            -e 'ghp_[A-Za-z0-9]{36}' \
            -e 'sk-[A-Za-z0-9]{20,}' \
            -e '-----BEGIN (RSA|OPENSSH|EC) PRIVATE KEY-----' .; then
            warn "Potential secrets found"
            return 1
        fi
        info "No obvious secrets found"
    else
        die "Install gitleaks, trufflehog, or ripgrep"
    fi
}

backup_project() {
    local folder="${1:-$PWD}"
    cd "$folder" || die "Cannot enter $folder"

    local stamp
    stamp=$(date +%Y%m%d-%H%M%S)
    mkdir -p "$BACKUP_DIR"

    if [[ -f compose.yaml || -f docker-compose.yml ]] &&
        docker compose ps db 2>/dev/null | grep -q 'Up'; then
        local user="${POSTGRES_USER:-app}"
        local db="${POSTGRES_DB:-app}"
        local out="$BACKUP_DIR/db-$stamp.sql"

        if docker compose exec -T db pg_dump -U "$user" "$db" >"$out"; then
            info "[OK] database backup: $out"
        else
            warn "pg_dump failed"
            rm -f "$out"
        fi
    else
        local name ext
        name=$(basename "$PWD")
        ext="tar.zst"
        local -a tar_opts=(--zstd -cf)

        if ! has zstd; then
            ext="tar.gz"
            tar_opts=(-czf)
        fi

        local out="$BACKUP_DIR/$name-$stamp.$ext"
        tar "${tar_opts[@]}" "$out" \
            --exclude=.venv --exclude=venv --exclude=__pycache__ \
            --exclude=.git --exclude=node_modules \
            -C "$(dirname "$PWD")" "$name" 2>/dev/null

        if [[ -f "$out" ]]; then
            info "[OK] project backup: $out"
        else
            warn "Backup failed"
        fi
    fi

    find "$BACKUP_DIR" -maxdepth 1 -type f \
        \( -name 'db-*.sql' -o -name '*.tar.zst' -o -name '*.tar.gz' \) \
        -printf '%T@ %p\n' 2>/dev/null |
        sort -nr |
        tail -n +11 |
        cut -d' ' -f2- |
        xargs -r rm -f --
}

dev_log() {
    if [[ $# -eq 0 ]]; then
        die "Usage: dev log <message>"
    fi

    mkdir -p "$(dirname "$LOG_FILE")"

    local day
    day=$(date +%F)
    grep -q "^## ${day}$" "$LOG_FILE" 2>/dev/null ||
        printf '\n## %s\n\n' "$day" >>"$LOG_FILE"

    printf -- '- **%s** - %s\n' "$(date +%H:%M)" "$*" >>"$LOG_FILE"
    info "Logged to $LOG_FILE"
}

roadmap() {
    if [[ ! -f "$BASE/README.md" ]]; then
        warn "README not found: $BASE/README.md"
        return 1
    fi

    info "LEARNING ROADMAP"
    info "----------------"
    awk '/^## Learning Milestones/{flag=1; next} /^---/{if(flag) exit} flag' "$BASE/README.md"

    info ""
    info "NEXT UNCHECKED ITEMS"
    info "--------------------"
    awk '/^## Learning Milestones/{flag=1; next} /^---/{if(flag) exit} flag && /- \[ \]/' "$BASE/README.md"
}

git_save() {
    if [ -z "${1:-}" ]; then
        echo "Usage: dev save 'message'"
        exit 1
    fi

    if git diff --quiet && git diff --cached --quiet; then
        echo "No changes to commit"
        exit 0
    fi

    git add .

    if ! git commit -m "$1"; then
        echo "Commit failed"
        exit 1
    fi

    local branch
    branch=$(git branch --show-current)

    if ! git push 2>/dev/null; then
        git push -u origin "$branch"
    fi

    echo "Changes pushed"
}

health_check() {
    local ram_usage
    local cpu_load
    local cpu_cores
    local cpu_usage
    local disk_usage

    ram_usage=$(free | awk '/Mem:/ {print int($3/$2 * 100)}')

    cpu_load=$(awk '{print $1}' /proc/loadavg)
    cpu_cores=$(nproc)

    cpu_usage=$(awk -v sys_load="$cpu_load" -v cores="$cpu_cores" 'BEGIN {print int((sys_load/cores)*100)}')

    disk_usage=$(df / | awk 'END {print int($5)}')

    echo "──────────────────────────────────────────────────"
    echo "SYSTEM HEALTH REPORT | $(date +'%B %d - %Y | %H:%M:%S')"
    echo "──────────────────────────────────────────────────"

    print_status() {
        local label=$1
        local value=$2

        if [ "$value" -ge 80 ]; then
            echo -e "$label: \e[31m$value%\e[0m (CRITICAL)"
        elif [ "$value" -ge 70 ]; then
            echo -e "$label: \e[33m$value%\e[0m (WARNING)"
        else
            echo -e "$label: \e[32m$value%\e[0m (OK)"
        fi
    }

    print_status "RAM" "$ram_usage"
    print_status "CPU" "$cpu_usage"
    print_status "Disk" "$disk_usage"

    echo "──────────────────────────────────────────────────"
}

case "${1:-help}" in
    new)
        case "${2:-}" in
            python) create_python_project "${3:-}" ;;
            api) create_api_project "${3:-}" ;;
            *) usage; exit 1 ;;
        esac
        ;;
    init) shift; init_project "${1:-$PWD}" ;;
    run) shift; run_project "${1:-$PWD}" ;;
    test) shift; test_project "${1:-$PWD}" ;;
    lint) shift; lint_project "${1:-$PWD}" ;;
    fmt) shift; fmt_project "${1:-$PWD}" ;;
    up) shift; up_project "${1:-$PWD}" ;;
    down) shift; down_project "${1:-$PWD}" ;;
    db) shift; db_project "${1:-$PWD}" ;;
    ship) shift; ship "${1:-}" ;;
    status) shift; status_project "${1:-$PWD}" ;;
    clean) shift; clean_project "$@" ;;
    doctor) doctor ;;
    secrets) shift; secrets_scan "${1:-$PWD}" ;;
    backup) shift; backup_project "${1:-$PWD}" ;;
    log) shift; dev_log "$@" ;;
    roadmap) roadmap ;;
    save) git_save "${2:-}" ;;
    health) health_check ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
esac
